# Cooperative Management SaaS Platform — Environment Variables
# Copy this file to .env for local development. NEVER commit .env.
#
# Which settings module is used is decided by config/runtime.py:
#   DJANGO_ENV=dev   -> config.settings.dev   (DEBUG on, browsable API)
#   DJANGO_ENV=prod  -> config.settings.prod  (hardened, HTTPS only)
# On Render, RENDER=true is set automatically and DJANGO_ENV defaults to prod.
DJANGO_ENV=dev

# ─── Django ────────────────────────────────────────────────────────────
# Production: generate with
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database (PostgreSQL) ─────────────────────────────────────────────
# Option A — single URL (what Render/managed Postgres gives you):
#   DATABASE_URL=postgres://user:pass@host:5432/dbname
# Option B — discrete variables (used when DATABASE_URL is empty):
DATABASE_URL=
DB_NAME=coop_db
DB_USER=coop_user
DB_PASSWORD=coop_pass
DB_HOST=localhost
DB_PORT=5432

# ─── Redis ─────────────────────────────────────────────────────────────
# Only needed if you start a Celery worker/beat. No tasks are used yet.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── JWT ───────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ─── Email ────────────────────────────────────────────────────────────
# Set these in deployment; the sender must be verified in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Cooperative Management Platform
# When BREVO_API_KEY is empty, the configured Django backend is used locally.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@cooperative-platform.com
PASSWORD_RESET_TIMEOUT=86400

# ─── File Storage ──────────────────────────────────────────────────────
MEDIA_ROOT=media/

# ─── CORS ──────────────────────────────────────────────────────────────
# Comma-separated, scheme included, no trailing slash.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Only needed for cookie/session-authenticated POSTs from a browser (Django
# admin). config/settings/prod.py derives these from ALLOWED_HOSTS automatically.
CSRF_TRUSTED_ORIGINS=

# ─── Production-only security toggles (config/settings/prod.py) ────────
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# LOG_LEVEL=INFO

# ─── Platform ──────────────────────────────────────────────────────────
PLATFORM_NAME=Cooperative Management Platform
PLATFORM_ADMIN_EMAIL=admin@cooperative-platform.com
