# Cooperative Management SaaS Platform — Environment Variables
# Copy this file to .env and fill in the values

# Django
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# Database (PostgreSQL)
DATABASE_URL=postgres://coop_user:coop_pass@localhost:5432/coop_db
DB_NAME=coop_db
DB_USER=coop_user
DB_PASSWORD=coop_pass
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@cooperative-platform.com

# File Storage
MEDIA_ROOT=media/
FILE_STORAGE_BACKEND=local

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Platform
PLATFORM_NAME=Cooperative Management Platform
PLATFORM_ADMIN_EMAIL=admin@cooperative-platform.com
